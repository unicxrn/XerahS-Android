{
  "Version": "17.0.0",
  "Name": "Pastebin",
  "DestinationType": "TextUploader",
  "RequestMethod": "POST",
  "RequestURL": "https://pastebin.com/api/api_post.php",
  "Body": "FormURLEncoded",
  "Arguments": {
    "api_dev_key": "{{api_key}}",
    "api_option": "paste",
    "api_paste_code": "{input}",
    "api_paste_private": "1"
  },
  "URL": "{regex:^https?://\\S+}"
}
